<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CatenoidDemo</AssemblyName>
    <RootNamespace>CatenoidDemo</RootNamespace>
    <UserSecretsId>6932d40e-dfac-4d96-9a39-f8d3ddfa26e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CatenoidCore\CatenoidCore.csproj" />
  </ItemGroup>

  <!-- The app lives at the repository root, so keep the sibling projects out of its globs. -->
  <ItemGroup>
    <Compile Remove="CatenoidCore\**" />
    <Compile Remove="CatenoidCore.Tests\**" />
    <None Remove="CatenoidCore\**" />
    <None Remove="CatenoidCore.Tests\**" />
  </ItemGroup>

</Project>
